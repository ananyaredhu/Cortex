# Copy to .env and fill in. NEVER commit .env.

# --- Model gateway (names only; final choices set after the Day-1 probe) ---
GENERATOR_BACKEND=auto          # adp | openai | template | auto (adp if ADP_APP_KEY is set, else openai if its URL and key are, else template)
GENERATOR_BASE_URL=             # openai backend: any /chat/completions endpoint (Tencent LKEAP, DeepSeek, Hunyuan)
GENERATOR_API_KEY=
GENERATOR_MODEL=deepseek-v3     # openai backend: the model to call; adp backend: the label for the model the agent uses
SMALL_MODEL_BASE_URL=
SMALL_MODEL_API_KEY=
SMALL_MODEL=
CHECKER_MODEL=cross-encoder/nli-deberta-v3-xsmall   # layer 2 grounding model (local CPU, ADR-003); empty or none = layer 1 only
GROUNDING_THRESHOLD=0.05        # measured for nli-deberta-v3-xsmall; MiniCheck models sit around 0.5
CHECKER_LLM_BASE_URL=
CHECKER_LLM_API_KEY=
CHECKER_LLM_MODEL=
EMBEDDING_BACKEND=bge-m3        # bge-m3 (default, local) | none (index without vectors); ingestion refuses hosted backends
HF_HOME=                        # where the bge-m3 model is cached (about 4.3 GB); empty = Hugging Face default in your user folder
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

# --- Optional Tencent services ---
ADP_APP_KEY=                    # adp backend: AppKey of the published agent (Application Management > Call); no knowledge base on it
ADP_CHAT_URL=                   # default https://wss.lke.tencentcloud.com/adp/v2/chat
TRTC_SDK_APP_ID=
TRTC_SDK_SECRET_KEY=

# --- Real connectors ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GDRIVE_WEBHOOK_TOKEN=            # random, 24+ chars; Drive push notifications must carry it (connectors/gdrive/watch.py)
ATLASSIAN_SITE=                 # only if a real tenant is used for content/webhooks

# --- App ---
DATABASE_URL=postgresql://brain:brain@localhost:5432/brain
BRAIN_ENV=dev                   # dev | production. production refuses to start with dev login on, short or missing keys, no CHECKER_MODEL
JWT_SIGNING_KEY=                # HS256 key, at least 32 bytes (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_AUDIENCE=internal-brain
AUDIT_SIGNING_KEY=              # Ed25519 seed, 32 bytes hex, signs audit checkpoints. Required in production; empty = a key made for this run only
AUDIT_DENIED_SALT=              # salts the hashed IDs of denied documents in the audit log. Change it from the default in production
BRAIN_MOCK_IDP=0                # 1 = serve POST /idp/token: pick a fictional persona, get a signed token (needs JWT_SIGNING_KEY). A demo IdP, no passwords
BRAIN_MOCK_IDP_TTL_S=900        # how long a mock token lives, in seconds
BRAIN_DEV_AUTH=1                # LOCAL DEVELOPMENT ONLY. 1 = accept `Bearer dev:<persona>` and serve /sim/*. Unset or 0 = off (the default)
BRAIN_SOURCES=confluence,jira,slack,gdrive
BRAIN_FLOOR_LATENCY_MS=300      # every /v1/ask takes at least this long (uniform timing for refusals)
BRAIN_RUNTIME=                  # fixture = serve the fixture corpus with no database (UI demo controls); empty = Postgres and the connectors.
                                # fixture mode keeps dev login on unless BRAIN_DEV_AUTH=0, and honors BRAIN_MOCK_IDP and JWT_SIGNING_KEY
LEAKCI_SCOREBOARD=              # the scoreboard /v1/leakci/latest serves; default evals/scoreboard/leakci-latest.json (python -m evals.leakci writes it)
