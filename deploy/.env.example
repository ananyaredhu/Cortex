# Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env. Names only here.
# Make a random value with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- The address ---
# the hostname people open, e.g. brain.example.com (DNS A record to this server); no scheme, no path
SITE_HOST=
# leave empty: Caddy serves https://SITE_HOST with its own certificate. Local try-out: http://localhost
SITE_ADDRESS=

# --- Secrets made for this deployment (random hex, a different one each) ---
# hex only (it goes into a URL)
POSTGRES_PASSWORD=
# guards the simulators' admin endpoints
SIM_ADMIN_TOKEN=
# 64 hex characters: signs the mock IdP's tokens
JWT_SIGNING_KEY=
# exactly 64 hex characters (an Ed25519 seed): signs audit checkpoints. Keep it across restarts
AUDIT_SIGNING_KEY=
# salts the hashed IDs of denied documents in the audit log
AUDIT_DENIED_SALT=

# --- Sign-in and clients ---
# the demo sign-in: pick a fictional persona. There is no other IdP yet
BRAIN_MOCK_IDP=1
# how long a token lasts; an hour suits a demo and a WorkBuddy session
BRAIN_MOCK_IDP_TTL_S=3600
# serve /mcp for WorkBuddy and CodeBuddy
BRAIN_MCP=1
JWT_AUDIENCE=internal-brain

# --- Sources ---
# start with the two simulators; add slack,gdrive once deploy/secrets/ holds their files (README, step 5)
BRAIN_SOURCES=confluence,jira
INGEST_POLL_SECONDS=600
BRAIN_FLOOR_LATENCY_MS=300

# --- Models ---
# 1 = the image carries torch for bge-m3 and the checker (needs 8 GB of memory). 0 = see README, "A small machine"
WITH_MODELS=1
# bge-m3 | none (keyword search only)
EMBEDDING_BACKEND=bge-m3
# production refuses to start without it
CHECKER_MODEL=cross-encoder/nli-deberta-v3-xsmall
GROUNDING_THRESHOLD=0.05
GENERATOR_BACKEND=auto
# the model the ADP agent really uses: the audit log records this label
GENERATOR_MODEL=
# AppKey of the published ADP agent
ADP_APP_KEY=

# --- Real Slack and Drive (only when they are in BRAIN_SOURCES) ---
SLACK_BOT_TOKEN=
# Socket Mode: Slack events with no inbound port
SLACK_APP_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# random, 24+ characters; Drive push notifications must carry it
GDRIVE_WEBHOOK_TOKEN=
