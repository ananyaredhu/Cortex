# Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env. Names only here.
# Make a random value with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- The address ---
SITE_HOST=                      # the hostname people open, e.g. brain.example.com (DNS A record to this server); no scheme, no path
SITE_ADDRESS=                   # leave empty: Caddy serves https://SITE_HOST with its own certificate. Local try-out: http://localhost

# --- Secrets made for this deployment (random hex, a different one each) ---
POSTGRES_PASSWORD=              # hex only (it goes into a URL)
SIM_ADMIN_TOKEN=                # guards the simulators' admin endpoints
JWT_SIGNING_KEY=                # 64 hex characters: signs the mock IdP's tokens
AUDIT_SIGNING_KEY=              # exactly 64 hex characters (an Ed25519 seed): signs audit checkpoints. Keep it across restarts
AUDIT_DENIED_SALT=              # salts the hashed IDs of denied documents in the audit log

# --- Sign-in and clients ---
BRAIN_MOCK_IDP=1                # the demo sign-in: pick a fictional persona. There is no other IdP yet
BRAIN_MOCK_IDP_TTL_S=3600       # how long a token lasts; an hour suits a demo and a WorkBuddy session
BRAIN_MCP=1                     # serve /mcp for WorkBuddy and CodeBuddy
JWT_AUDIENCE=internal-brain

# --- Sources ---
BRAIN_SOURCES=confluence,jira   # start with the two simulators; add slack,gdrive once deploy/secrets/ holds their files (README, step 5)
INGEST_POLL_SECONDS=600
BRAIN_FLOOR_LATENCY_MS=300

# --- Models ---
WITH_MODELS=1                   # 1 = the image carries torch for bge-m3 and the checker (needs 8 GB of memory). 0 = see README, "A small machine"
EMBEDDING_BACKEND=bge-m3        # bge-m3 | none (keyword search only)
CHECKER_MODEL=cross-encoder/nli-deberta-v3-xsmall   # production refuses to start without it
GROUNDING_THRESHOLD=0.05
GENERATOR_BACKEND=auto
GENERATOR_MODEL=                # the model the ADP agent really uses: the audit log records this label
ADP_APP_KEY=                    # AppKey of the published ADP agent

# --- Real Slack and Drive (only when they are in BRAIN_SOURCES) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=                # Socket Mode: Slack events with no inbound port
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GDRIVE_WEBHOOK_TOKEN=           # random, 24+ characters; Drive push notifications must carry it
