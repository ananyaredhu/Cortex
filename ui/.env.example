# Names only. Copy to .env.local for local overrides; never commit real values.
# Where the dev server proxies /v1 and /sim (default: the stub API on :8000).
API_TARGET=
# Show the demo controls drawer (advance scripted events, reset, tamper). Never on in production.
VITE_DEMO_CONTROLS=
# Show the Compare people page (/compare) outside demo mode. A demo screen, never on in production.
VITE_COMPARE_PEOPLE=
